; Capture L_63B9 object BACKTAB writes at runtime
; We break at the MVO@ R0, R5 instruction (5EC7 for tile stream, 63F2 for objects)
; and capture what's being written to BACKTAB

; First, let the game boot and enter the first room
; We'll set breakpoints at key BACKTAB write points

; ============================================
; Capture L_5EC7 output (tile stream → BACKTAB)
; ============================================
; L_5EC7 writes via MVO@ R1, R4 at:
;   5E2C (in L_5E03), 5EB6 (in L_5E8D), 5EF9 (in L_5EE2)
; R1 = BACKTAB word, R4 = BACKTAB address

; ============================================
; Capture L_63B9 output (objects → BACKTAB)
; ============================================
; L_63B9 writes via MVO@ R0, R5 at 63F2
; R0 = BACKTAB word, R5 = BACKTAB address

; ============================================
; Capture strategy: 
; 1. Let game boot to title screen
; 2. Press a button to start game
; 3. Wait for first room to render
; 4. Capture all BACKTAB writes during room render
; ============================================

; Wait for game to boot (4 seconds at max speed)
s 4

; Press button to start game
; This will go through title screen into first room
k 1,0,8    ; press keypad 1
s 0.5
k 1,0,0    ; release

; Wait for room to render
s 3

; Now set breakpoints at key BACKTAB write points
; We'll trace from here

; === Tile stream BACKTAB writes ===
b 5E2C     ; MVO@ R1, R4 in L_5E03
b 5EB6     ; MVO@ R1, R4 in L_5E8D  
b 5EF9     ; MVO@ R1, R4 in L_5EE2

; === Object BACKTAB writes ===
b 63F2     ; MVO@ R0, R5 in L_63B9

; Now let the game run to trigger another room render
; (moving between rooms would trigger re-render)
s 2

; Remove breakpoints and dump BACKTAB
b -5E2C
b -5EB6
b -5EF9
b -63F2

; Dump BACKTAB ($0200-$02F3 = 20x12 = 240 words)  
; We'll dump in 6 rows of 40 bytes (20 words) each
e 0200 0200 0201 0202 0203 0204 0205 0206 0207 0208 0209 020A 020B 020C 020D 020E 020F 0210 0211 0212 0213
e 0214 0215 0216 0217 0218 0219 021A 021B 021C 021D 021E 021F 0220 0221 0222 0223 0224 0225 0226 0227
e 0228 0229 022A 022B 022C 022D 022E 022F 0230 0231 0232 0233 0234 0235 0236 0237 0238 0239 023A 023B
e 023C 023D 023E 023F 0240 0241 0242 0243 0244 0245 0246 0247 0248 0249 024A 024B 024C 024D 024E 024F
e 0250 0251 0252 0253 0254 0255 0256 0257 0258 0259 025A 025B 025C 025D 025E 025F 0260 0261 0262 0263
e 0264 0265 0266 0267 0268 0269 026A 026B 026C 026D 026E 026F 0270 0271 0272 0273 0274 0275 0276 0277
e 0278 0279 027A 027B 027C 027D 027E 027F 0280 0281 0282 0283 0284 0285 0286 0287 0288 0289 028A 028B
e 028C 028D 028E 028F 0290 0291 0292 0293 0294 0295 0296 0297 0298 0299 029A 029B 029C 029D 029E 029F
e 02A0 02A1 02A2 02A3 02A4 02A5 02A6 02A7 02A8 02A9 02AA 02AB 02AC 02AD 02AE 02AF 02B0 02B1 02B2 02B3
e 02B4 02B5 02B6 02B7 02B8 02B9 02BA 02BB 02BC 02BD 02BE 02BF 02C0 02C1 02C2 02C3 02C4 02C5 02C6 02C7
e 02C8 02C9 02CA 02CB 02CC 02CD 02CE 02CF 02D0 02D1 02D2 02D3 02D4 02D5 02D6 02D7 02D8 02D9 02DA 02DB
e 02DC 02DD 02DE 02DF 02E0 02E1 02E2 02E3 02E4 02E5 02E6 02E7 02E8 02E9 02EA 02EB 02EC 02ED 02EE 02EF
e 02F0 02F1 02F2 02F3

; Dump key SYSRAM variables
e 0175 0176 0178 0180 0181 0182 0183 0184 0185 0186 0187
e 019C 01A8 01AB 01AC 01AD
e 02F4 02F5 02F6 02F7

q
